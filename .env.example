# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env al repositorio.

# ── Base de datos ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=lasmunecasderamon
DB_USER=postgres
DB_PASSWORD=
# DB_POOL_MAX=10
# DB_TZ=America/Santiago

# ── Seguridad / JWT ───────────────────────────────────────────
# Mínimo 64 caracteres y alta entropía (se valida al arrancar en producción).
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── URLs públicas ─────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_SOCKET_URL=
# BASE_URL=http://localhost:3000

# ── Twilio / WhatsApp (opcionales) ────────────────────────────
# Con valor por defecto: se editan en Configuraciones → WhatsApp y quedan en la
# base de datos. Un campo vacío en la base cae a la variable de este archivo.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=
# ADMIN_WHATSAPP_NUMBER=

# ── Kiosko / dispositivos ─────────────────────────────────────
# KIOSK_DEVICE_SECRET=

# ── Biometría (lector Dahua) ──────────────────────────────────
# Eventos: NetSDK en Windows/Linux x64; CGI snapManager/eventManager como alternativa.
# BIOMETRIC_EVENTS_SDK=false
# Video: FFmpeg se instala con pnpm install; ruta alternativa opcional.
# BIOMETRIC_FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# Carpeta con la librería del NetSDK (dhnetsdk.dll en Windows, libdhnetsdk.so en
# Linux). Por defecto:
#   Windows: C:\Program Files\SmartPSSLite
#   Linux:   /opt/SmartPSSLite
# DAHUA_SDK_DIR=
#
# Similitud mínima (0..1) para dar por coincidente la cara capturada contra la
# foto guardada (motor facial del equipo + coseno). Medido en ASI3213A-W:
# personas distintas ≈ -0.15..0.17; misma persona ≈ 0.91. Por defecto: 0.7
# BIOMETRIC_FACE_MATCH_THRESHOLD=
#
# Vigilante de IP: cada ciclo verifica que el lector siga en su IP (puerto 80 +
# serial) y si DHCP la cambió la re-busca por MAC, actualiza la BD y reinicia el
# listener. Encendido por defecto; apagar con BIOMETRIC_IP_WATCH=off.
# BIOMETRIC_IP_WATCH=on
# Frecuencia del ciclo en ms (mínimo 30000; por defecto 300000 = 5 min).
# BIOMETRIC_IP_WATCH_MS=300000

# ── Redis (rate limit / caché en producción) ──────────────────
# REDIS_URL=redis://localhost:6379

# ── Tests E2E / benchmarks (nunca usar la password real de prod) ──
# TEST_USER=admin
# TEST_PASSWORD=
# WARMUP_USER=
# WARMUP_PASSWORD=

# ── Desarrollo ────────────────────────────────────────────────
# SKIP_RATE_LIMIT=true
# SKIP_JWT_VALIDATION=true
# DEV_ALLOWED_ORIGINS=http://localhost:3000
# PORT=3000
# HOST=0.0.0.0

# Redis local (Ubuntu / WSL)
REDIS_URL=redis://127.0.0.1:6379

# Windows: distribución WSL que mantiene Redis activo durante pnpm dev
REDIS_WSL_DISTRO=Ubuntu
