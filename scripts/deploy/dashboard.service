[Unit]
Description=Las Munecas de Ramon dashboard (Next.js)
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/lasmunecasderamon-dashboard/current
Environment=NODE_ENV=production
Environment=TZ=UTC
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
