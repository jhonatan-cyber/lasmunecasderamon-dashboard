#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Ejecutando pre-commit hooks..."

# 0. Check all files have 'use client' where needed
echo "🔍 Verificando directiva 'use client' en archivos con hooks..."
pnpm run check:use-client || exit 1

# 1. Lint and format staged files
# --max-arg-length fuerza a lint-staged a trocear la lista de archivos: en Windows
# la linea de comandos de cmd.exe se corta en 8191 caracteres y un commit con
# muchos archivos fallaba con "La linea de comandos es demasiado larga".
echo "🧐 Linting y formateo de archivos staged..."
pnpm exec lint-staged --max-arg-length 7000 || exit 1

# 2. Type check the whole project
echo "Checking tipos con TypeScript..."
pnpm run typecheck || exit 1

echo "✅ Todo listo para el commit!"
