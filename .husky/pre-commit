# Husky ejecuta este archivo con `sh -e` desde .husky/_/h, así que no hacen
# falta el shebang ni el source de husky.sh: son las dos líneas que husky v10
# rechaza (el aviso DEPRECATED lo imprimía _/husky.sh al sourcearse).
echo "🚀 Ejecutando pre-commit hooks..."

# 0. Check 'use client' where needed, solo en los .ts/.tsx staged.
# Antes recorría los ~1685 archivos del árbol (~28 s por commit) y podía fallar
# por archivos del otro frente; con --staged el escaneo cuesta ~0.3 s (el resto
# del hook es el arranque de pnpm). El barrido del árbol completo (sin --staged)
# ahora corre en CI: job "Directivas y typecheck".
echo "🔍 Verificando directiva 'use client' en archivos staged..."
pnpm run check:use-client:staged || exit 1

# 1. Lint y formato SOLO de los archivos staged.
# --max-arg-length fuerza a lint-staged a trocear la lista de archivos: en Windows
# la linea de comandos de cmd.exe se corta en 8191 caracteres y un commit con
# muchos archivos fallaba con "La linea de comandos es demasiado larga".
# --no-stash apaga el backup automatico: sin el, lint-staged guarda en un stash
# TODOS los cambios sin commitear del arbol (el otro frente tenia ~170 archivos)
# y los vuelve a restaurar en cada commit; si algo falla a mitad de camino, ese
# trabajo queda guardado lejos del arbol.
echo "🧐 Linting y formateo de archivos staged..."
pnpm exec lint-staged --max-arg-length 7000 --no-stash || exit 1

# 2. Sin typecheck acá: tsc compila el proyecto entero (~28 s) y en el commit
# solo entra lo que se resuelve en segundos sobre el índice. El typecheck
# completo corre en pre-push (.husky/pre-push), al publicar el árbol.

echo "✅ Todo listo para el commit!"
