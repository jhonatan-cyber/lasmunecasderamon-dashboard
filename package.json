    "react": "^19.2.7",
    "react-day-picker": "10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.1.2",
    "server-only": "^0.0.1",
