{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && echo 'Build completed successfully'",
    "build:analyze": "ANALYZE=true next build",
    "dev": "cross-env TZ=UTC next dev --hostname 0.0.0.0",
    "lint": "eslint app/layout.tsx app/page.tsx app/landing components/LayoutContent.tsx components/providers/ProtectedAppProviders.tsx components/landing/Navigation.tsx lib/api/site.ts --ignore-pattern .next --ignore-pattern node_modules",
    "lint:full": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern .next --ignore-pattern node_modules",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.typecheck.json --strict",
    "typecheck:paths": "tsc --noEmit -p tsconfig.typecheck.json",
    "start": "cross-env TZ=UTC next start --hostname 0.0.0.0",
    "prepare": "husky install",
    "lint:fix": "eslint app/layout.tsx app/page.tsx app/landing components/LayoutContent.tsx components/providers/ProtectedAppProviders.tsx components/landing/Navigation.tsx lib/api/site.ts --fix --ignore-pattern .next --ignore-pattern node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup": "node database/setup.js",
    "db:import": "node database/import-production.js",
    "db:password": "node database/generate-password.js",
    "optimize:images": "node scripts/optimize-images.js",
    "audit:web:quality": "node ./.agents/skills/web-quality-audit/scripts/analyze.mjs --format=markdown",
    "audit:web:quality:json": "node ./.agents/skills/web-quality-audit/scripts/analyze.mjs --format=json",
    "audit:web:quality:ci": "node ./.agents/skills/web-quality-audit/scripts/analyze.mjs --format=json \"--fail-rules=Accessibility:high,SEO:high,Best Practices:high\"",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "node tests/integration/order_flow.test.js",
    "test:integration:settings": "node tests/integration/settings_clean.test.js",
    "test:ci": "vitest run && playwright test",
    "test:integration:legacy-db": "node scripts/run-legacy-db-tests.js"
  },
