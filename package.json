{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bones:build": "npx boneyard-js build",
    "build": "next build && node scripts/generate-sw.js && echo 'Build completed successfully'",
    "build:analyze": "ANALYZE=true next build && node scripts/generate-sw.js",
    "build:sw": "node scripts/generate-sw.js",
    "dev": "node scripts/generate-sw.js --dev && node scripts/dev-lan-auto.js",
    "dev:mobile": "node scripts/generate-sw.js --dev && cross-env TZ=UTC next dev --webpack --no-server-fast-refresh --hostname 0.0.0.0 --port 3000",
    "dev:lan": "node scripts/generate-sw.js --dev && cross-env TZ=UTC next dev --webpack --no-server-fast-refresh --hostname 192.168.0.12 --port 3000",
    "dev:lan:auto": "node scripts/generate-sw.js --dev && node scripts/dev-lan-auto.js",
    "postinstall": "node -e \"if (process.env.SKIP_SW_GENERATE) process.exit(0); require('child_process').execSync('node scripts/generate-sw.js --dev', { stdio: 'inherit' })\"",
    "lint": "eslint app/layout.tsx app/page.tsx components/layout/LayoutContent.tsx components/providers/ProtectedAppProviders.tsx lib/api/site.ts --ignore-pattern .next --ignore-pattern node_modules",
    "lint:full": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern .next --ignore-pattern node_modules",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.typecheck.json --strict",
    "typecheck:paths": "tsc --noEmit -p tsconfig.typecheck.json",
    "start": "cross-env TZ=UTC next start --hostname 0.0.0.0",
    "serve:mobile": "cross-env TZ=UTC next build && cross-env TZ=UTC next start --hostname 0.0.0.0 --port 3000",
    "start:warmup": "cross-env SKIP_BUILD=true node scripts/production-start.js",
    "build:start": "node scripts/production-start.js",
    "prepare": "husky install",
    "lint:fix": "eslint app/layout.tsx app/page.tsx components/layout/LayoutContent.tsx components/providers/ProtectedAppProviders.tsx lib/api/site.ts --fix --ignore-pattern .next --ignore-pattern node_modules",
    "check:use-client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-use-client.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup": "node database/setup.js",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:dev": "node scripts/db-dev.js",
    "db:import": "node database/import-production.js",
    "db:password": "node database/generate-password.js",
    "optimize:images": "node scripts/optimize-images.js",
    "audit:web:quality": "node ./.agents/skills/web-quality-audit/scripts/analyze.mjs --format=markdown",
    "audit:web:quality:json": "node ./.agents/skills/web-quality-audit/scripts/analyze.mjs --format=json",
    "audit:web:quality:ci": "node ./.agents/skills/web-quality-audit/scripts/analyze.mjs --format=json \"--fail-rules=Accessibility:high,SEO:high,Best Practices:high\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "node tests/integration/order_flow.test.js",
    "test:integration:settings": "node tests/integration/settings_clean.test.js",
    "test:ci": "vitest run",
    "test:integration:legacy-db": "node scripts/run-legacy-db-tests.js",
    "test:integration:all": "node scripts/run-integration-all.js",
    "test:e2e": "playwright test --config playwright.config.ts",
    "clean": "node -e \"const fs=require('fs');['.next','tsconfig.tsbuildinfo','tsconfig.typecheck.tsbuildinfo'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}});console.log('Cache limpiado correctamente')\"",
    "clean:all": "node -e \"const fs=require('fs');['.next','node_modules','tsconfig.tsbuildinfo','tsconfig.typecheck.tsbuildinfo'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}});console.log('Cache y dependencias limpiados. Ejecuta pnpm install para reinstalar')\"",
    "dev:clean": "pnpm clean && pnpm dev",
    "build:clean": "pnpm clean && pnpm build",
    "warmup": "node scripts/warmup.mjs",
    "dev:warmup": "node scripts/dev-lan-auto.js",
    "purge:logs": "node scripts/purge-query-logs.js",
    "purge:logs:dry": "node scripts/purge-query-logs.js --dry-run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
