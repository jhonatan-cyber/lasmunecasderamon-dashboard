{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bones:build": "npx boneyard-js build",
    "build": "next build --webpack && node scripts/generate-sw.js && echo 'Build completed successfully'",
    "build:analyze": "ANALYZE=true next build --webpack && node scripts/generate-sw.js",
    "build:sw": "node scripts/generate-sw.js",
    "dev": "node scripts/generate-sw.js --dev && node scripts/dev-lan-auto.js",
    "dev:mobile": "node scripts/generate-sw.js --dev && cross-env TZ=UTC next dev --webpack --no-server-fast-refresh --hostname 0.0.0.0 --port 3000",
    "dev:lan": "node scripts/generate-sw.js --dev && node scripts/dev-lan-auto.js",
    "dev:lan:auto": "node scripts/generate-sw.js --dev && node scripts/dev-lan-auto.js",
    "postinstall": "node -e \"if (process.env.SKIP_SW_GENERATE) process.exit(0); require('child_process').execSync('node scripts/generate-sw.js --dev', { stdio: 'inherit' })\"",
    "lint": "eslint app/layout.tsx app/page.tsx components/layout/LayoutContent.tsx components/providers/ProtectedAppProviders.tsx lib/api/site.ts --ignore-pattern .next --ignore-pattern node_modules",
    "lint:full": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern .next --ignore-pattern node_modules",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.typecheck.json --strict",
    "start": "cross-env TZ=UTC next start --hostname 0.0.0.0",
    "serve:mobile": "cross-env TZ=UTC next build && cross-env TZ=UTC next start --hostname 0.0.0.0 --port 3000",
    "start:warmup": "cross-env SKIP_BUILD=true node scripts/production-start.js",
    "build:start": "node scripts/production-start.js",
    "prepare": "husky install",
    "lint:fix": "eslint app/layout.tsx app/page.tsx components/layout/LayoutContent.tsx components/providers/ProtectedAppProviders.tsx lib/api/site.ts --fix --ignore-pattern .next --ignore-pattern node_modules",
    "check:use-client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-use-client.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup": "node scripts/ci-setup-db.js",
    "seed:asistencia": "node modules/asistencia/seed/seed-asistencia.mjs",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:plan": "node scripts/run-migrations.mjs --plan",
    "db:dev": "node scripts/db-dev.js",
    "redis:start": "node scripts/redis-dev.js",
    "redis:check": "node scripts/redis-dev.js --check",
    "test:redis": "vitest run --config vitest.redis.config.ts",
    "benchmark:dashboard": "vitest run --config vitest.dashboard-benchmark.config.ts",
    "audit:web:quality": "node ./.agents/skills/web-quality-audit/scripts/analyze.mjs --format=markdown",
    "audit:web:quality:json": "node ./.agents/skills/web-quality-audit/scripts/analyze.mjs --format=json",
    "audit:web:quality:ci": "node ./.agents/skills/web-quality-audit/scripts/analyze.mjs --format=json \"--fail-rules=Accessibility:high,SEO:high,Best Practices:high\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "node tests/integration/order_flow.test.js",
    "test:integration:settings": "node tests/integration/settings_clean.test.js",
    "test:integration:legacy-db": "node scripts/run-legacy-db-tests.js",
    "test:integration:all": "node scripts/run-integration-all.js",
    "test:e2e": "playwright test --config playwright.config.ts",
    "clean": "node -e \"const fs=require('fs');['.next','tsconfig.tsbuildinfo','tsconfig.typecheck.tsbuildinfo'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}});console.log('Cache limpiado correctamente')\"",
    "clean:all": "node -e \"const fs=require('fs');['.next','node_modules','tsconfig.tsbuildinfo','tsconfig.typecheck.tsbuildinfo'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}});console.log('Cache y dependencias limpiados. Ejecuta pnpm install para reinstalar')\"",
    "dev:clean": "pnpm clean && pnpm dev",
    "build:clean": "pnpm clean && pnpm build",
    "warmup": "node scripts/warmup.mjs",
    "dev:warmup": "node scripts/dev-lan-auto.js",
    "purge:logs": "node scripts/purge-query-logs.js",
    "purge:logs:dry": "node scripts/purge-query-logs.js --dry-run",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "db:check": "node scripts/db_test.js",
    "db:verify": "node scripts/verify-migrations.mjs",
    "db:diff": "node scripts/compare-schema.mjs",
    "db:parity": "node scripts/verify-schema-parity.mjs",
    "db:reconcile": "node scripts/reconcile-migration-checksum.mjs",
    "arquitectura": "node scripts/arquitectura/analisis.mjs",
    "arquitectura:json": "node scripts/arquitectura/analisis.mjs --json",
    "arquitectura:limites": "node scripts/arquitectura/limites.mjs",
    "arquitectura:excepciones": "node scripts/arquitectura/limites.mjs --listar"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@preact/signals-react": "^3.12.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@wrksz/themes": "^2.0.3",
    "argon2": "^0.45.1",
    "boneyard-js": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.1.0",
    "expo-server-sdk": "^7.2.0",
    "ffmpeg-static": "^5.3.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jsbarcode": "^3.12.3",
    "jspdf": "4.2.1",
    "jspdf-autotable": "^5.0.2",
    "koffi": "^3.3.2",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "onnxruntime-node": "^1.30.0",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "swagger-ui-react": "^5.33.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.1.2",
    "use-debounce": "^10.1.0",
    "winston": "^3.17.0",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "3.2.7",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.3.8",
    "exceljs": "^4.4.0",
    "husky": "^8.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.4",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "typescript": "^5",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "engines": {
    "node": ">=24"
  }
}
