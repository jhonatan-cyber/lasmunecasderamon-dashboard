{
  "name": "lasmunecas-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servidor MCP del dashboard Las Muñecas de Ramon: consultas y operaciones por HTTP + herramientas de desarrollo locales.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lasmunecas-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "mcp-config.example.json"
  ],
  "scripts": {
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^5.9.3"
  }
}
